# Database
DATABASE_URL=sqlite:///./healthtrack.db
# For PostgreSQL: postgresql://user:password@localhost:5432/healthtrack

# Auth
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Gemini (optional - users can also set via Settings UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
